# JSON map of villa unit -> construction "Time Schedule" feed URL (Apps Script /exec).
CONSTRUCTION_FEEDS={"C3":"https://script.google.com/macros/s/…/exec","A2":"https://script.google.com/macros/s/…/exec"}

# Optional: Apps Script /exec URL returning the daily labour JSON for the Laporan
# Harian tab: {date, units:[{id,block,type,batch,plan,workers,comp,folder}]}.
# Unset = serve the snapshot committed in daily-data.mjs.
# DAILY_FEED=https://script.google.com/macros/s/…/exec

# Optional: staleness threshold in days (default 10) and local server port (default 3000).
# STALE_DAYS=10
# PORT=3000
# CACHE_TTL_MIN=360   # Node server in-memory cache (minutes); Refresh bypasses it
